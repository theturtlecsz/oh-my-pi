FROM oven/bun:1.4.0-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV HOME=/home/agent

RUN apt-get update -qq && \
    apt-get install -y -qq --no-install-recommends \
        git \
        python3 \
        ca-certificates && \
    rm -rf /var/lib/apt/lists/*

RUN ln -sf /usr/bin/python3 /usr/local/bin/python

# In oven/bun, uid 1000 is bun. Rename bun to agent with home /home/agent
RUN usermod -l agent -d /home/agent -m bun && groupmod -n agent bun

WORKDIR /workspace

COPY . /workspace

RUN rm -rf node_modules

RUN git config --global user.name "omp-harbor" && \
    git config --global user.email "omp-harbor@localhost" && \
    git config --global init.defaultBranch main && \
    git config --global --add safe.directory /workspace

RUN bun install && \
    bun add zod@3.25.76

RUN if [ ! -d .git ]; then \
        git init && \
        git add -A && \
        git commit -m "initial harbor worker tree" ; \
    fi

RUN cat > /usr/local/bin/omp << 'SH'
#!/bin/sh
exec bun /workspace/packages/coding-agent/src/cli.ts "$@"
SH
RUN chmod +x /usr/local/bin/omp

RUN chown -R agent:agent /workspace /home/agent

USER agent
