FROM postgres:16-bookworm

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

RUN apt-get update -qq && \
    apt-get install -y -qq --no-install-recommends \
        python3 \
        python3-pip \
        ca-certificates && \
    rm -rf /var/lib/apt/lists/*

RUN ln -sf /usr/bin/python3 /usr/local/bin/python

RUN pip install --no-cache-dir --break-system-packages \
    "fastapi>=0.112,<1" \
    "uvicorn>=0.30,<1" \
    "pydantic>=2.12.5,<2.13" \
    "psycopg[binary]>=3.3.4,<3.4" \
    "httpx>=0.27,<1"

WORKDIR /opt

COPY python/omp-rpc /opt/omp-rpc
COPY python/omp-work /opt/omp-work

RUN pip install --no-cache-dir --break-system-packages --no-deps -e /opt/omp-rpc -e /opt/omp-work

RUN mkdir -p /var/lib/postgresql/data /run/omp/credentials && \
    chown -R postgres:postgres /var/lib/postgresql && \
    chmod 0700 /run/omp/credentials

ENV PYTHONPATH="/opt/omp-work/src:/opt/omp-rpc/src"

ENTRYPOINT []
CMD ["python", "-m", "omp_work.service"]
