-			severity: SEVERITIES[Math.floor(rng() * SEVERITIES.length)],
-			category: CATEGORIES[Math.floor(rng() * CATEGORIES.length)] ?? "semantic-concern",
-		});
-	};
-	const episodes = 3 + Math.floor(rng() * 4);
-	for (let episode = 0; episode < episodes; episode++) {
