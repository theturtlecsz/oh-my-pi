-	"model-procedure-miss",
-	"semantic-concern",
-	"policy-ambiguity",
-	"possible-false-positive",
-] as const satisfies readonly AdvisorCategory[];
-
-const SEVERITIES: readonly (AdvisorSeverity | undefined)[] = [undefined, "nit", "concern", "blocker"];
