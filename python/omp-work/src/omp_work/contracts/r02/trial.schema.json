{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "omp:r02:trial",
  "title": "Trial",
  "type": "object",
  "required": [
    "id",
    "campaign_id",
    "revision",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "campaign_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "native_candidate_id": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
