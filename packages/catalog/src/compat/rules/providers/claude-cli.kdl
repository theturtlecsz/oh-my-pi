// Anthropic models served by the locally installed `claude` CLI (headless
// `claude -p`) instead of an HTTP API. The CLI authenticates itself, so the
// provider is keyless and the bundled seed is its whole catalog.

provider "claude-cli" {
	default-model "claude-opus-5-5"
	allow-unauthenticated #true
	skip-cross-provider-reference-fills #true

	seed api="claude-cli" base-url="claude://cli" bundle="always" {
		model "claude-opus-5-5" name="Claude Opus 5.5" {
			reasoning #true
			input "text"
			cost input=4 output=20 cache-read=0.2 cache-write=5
			limits context=1000000 max-tokens=128000
			supports-tools #false
		}
	}
}
